// ============================================================
// Round 2 optimizations — appended module (imported after _extend)
// Reference: tyrantlucifer.com / blog.umrs.cc
// ============================================================

// Smooth scrolling + anchor offset (topbar is fixed)
html
  scroll-behavior: smooth

.article-entry
  h1, h2, h3, h4, h5, h6
    scroll-margin-top: 78px

@media (prefers-reduced-motion: reduce)
  html
    scroll-behavior: auto

// ============================================================
// Sticky topbar (appears after scrolling)
// ============================================================
.topbar
  position: fixed
  top: 0
  left: 0
  right: 0
  height: 56px
  z-index: 9000
  display: flex
  align-items: center
  gap: 8px
  padding: 0 22px
  background: var(--bg-alpha)
  backdrop-filter: blur(14px) saturate(1.4)
  -webkit-backdrop-filter: blur(14px) saturate(1.4)
  border-bottom: 1px solid var(--border)
  box-shadow: var(--shadow-sm)
  transform: translateY(-110%)
  transition: transform var(--transition-base), background var(--transition-slow)
  &.visible
    transform: translateY(0)

.topbar-brand
  font-size: 17px
  font-weight: 800
  color: var(--text-primary)
  text-decoration: none
  letter-spacing: -.01em
  white-space: nowrap
  &:hover
    color: var(--accent)

.topbar-nav
  display: flex
  align-items: center
  gap: 2px
  margin-left: 26px

.topbar-link
  padding: 7px 13px
  border-radius: var(--radius-full)
  color: var(--text-secondary)
  font-size: 14px
  font-weight: 600
  text-decoration: none
  transition: all var(--transition-fast)
  &:hover
    color: var(--accent)
    background: var(--accent-bg)

.topbar-actions
  margin-left: auto
  display: flex
  align-items: center
  gap: 8px

.topbar-btn
  display: inline-flex
  align-items: center
  justify-content: center
  width: 36px
  height: 36px
  border-radius: var(--radius-full)
  background: var(--bg-elevated)
  border: 1px solid var(--border)
  color: var(--text-secondary)
  cursor: pointer
  font-size: 14px
  transition: all var(--transition-fast)
  &:hover
    background: var(--accent)
    color: #fff
    border-color: var(--accent)
    transform: translateY(-1px)

.topbar-theme-btn .fa-sun
  display: none
.topbar-theme-btn .fa-moon
  display: inline
[data-theme="dark"] .topbar-theme-btn .fa-sun
  display: inline
[data-theme="dark"] .topbar-theme-btn .fa-moon
  display: none

// ============================================================
// Dark mode toggle (rightside) icon swap
// ============================================================
#darkmode-toggle .fa-sun
  display: none
#darkmode-toggle .fa-moon
  display: inline
[data-theme="dark"] #darkmode-toggle .fa-sun
  display: inline
[data-theme="dark"] #darkmode-toggle .fa-moon
  display: none

// Back-to-top: show only after scrolling
#go-up
  opacity: 0
  visibility: hidden
  transform: translateY(6px)
  transition: all var(--transition-base)
  pointer-events: none
  &.shown
    opacity: .9
    visibility: visible
    transform: translateY(0)
    pointer-events: auto

// ============================================================
// Taxonomy index pages (tags / categories)
// ============================================================
.taxonomy-page
  padding: 34px 32px

.page-title
  margin: 0 0 6px
  font-size: 30px
  font-weight: 800
  letter-spacing: -.02em
  color: var(--text-primary)

.page-subtitle
  margin: 0 0 26px
  color: var(--text-muted)
  font-size: 14px

.tag-cloud-full
  display: flex
  flex-wrap: wrap
  gap: 10px

.tag-chip
  display: inline-flex
  align-items: center
  gap: 8px
  padding: 9px 16px
  border-radius: var(--radius-full)
  background: var(--accent-bg)
  border: 1px solid var(--accent-border)
  color: var(--accent)
  font-size: 14px
  font-weight: 600
  text-decoration: none
  transition: all var(--transition-fast)
  .tag-count
    min-width: 20px
    height: 20px
    padding: 0 6px
    display: inline-flex
    align-items: center
    justify-content: center
    border-radius: var(--radius-full)
    background: var(--accent)
    color: #fff
    font-size: 11px
    font-weight: 700
  &:hover
    background: var(--accent)
    color: #fff
    border-color: var(--accent)
    transform: translateY(-2px)
    box-shadow: var(--shadow-md)
    .tag-count
      background: rgba(255,255,255,.25)

.category-list-full
  display: grid
  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr))
  gap: 14px

.category-chip
  display: flex
  align-items: center
  gap: 12px
  padding: 16px 18px
  border-radius: var(--radius-md)
  background: var(--bg-elevated)
  border: 1px solid var(--border)
  color: var(--text-primary)
  text-decoration: none
  transition: all var(--transition-fast)
  i
    font-size: 20px
    color: var(--accent)
  .category-name
    font-weight: 700
    font-size: 15px
    flex: 1
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
  .category-count
    padding: 3px 12px
    border-radius: var(--radius-full)
    background: var(--accent-bg)
    color: var(--accent)
    font-size: 12px
    font-weight: 600
  &:hover
    border-color: var(--accent-border)
    background: var(--bg-hover)
    transform: translateY(-2px)
    box-shadow: var(--shadow-md)

// ============================================================
// Post page: two-column shell + TOC
// ============================================================
.post-shell
  display: grid
  grid-template-columns: minmax(0, 1fr) 272px
  gap: 28px
  align-items: start

.post-main
  min-width: 0

.post-toc-wrap
  position: sticky
  top: 84px
  max-height: calc(100vh - 110px)
  overflow: auto

.post-toc-card
  background: var(--bg-surface)
  border: 1px solid var(--border)
  border-radius: var(--radius-lg)
  box-shadow: var(--shadow-sm)
  padding: 18px 16px
  transition: box-shadow var(--transition-base), border-color var(--transition-base)
  &:hover
    box-shadow: var(--shadow-md)
    border-color: var(--accent-border)

.post-toc-header
  display: flex
  align-items: center
  gap: 8px
  margin: 0 4px 12px
  font-size: 15px
  font-weight: 800
  color: var(--text-primary)
  i
    color: var(--accent)

.post-toc-nav
  .toc
    list-style: none
    margin: 0
    padding: 0
  .toc-item
    margin: 0
  .toc-link
    display: block
    padding: 5px 10px
    margin: 1px 0
    border-radius: 8px
    color: var(--text-secondary)
    font-size: 13.5px
    line-height: 1.5
    text-decoration: none
    transition: all var(--transition-fast)
    &:hover
      color: var(--accent)
      background: var(--accent-bg)
    &.active
      color: var(--accent)
      background: var(--accent-bg)
      font-weight: 700
  .toc-child
    list-style: none
    margin: 0
    padding-left: 12px

// Mobile collapsible TOC (hidden on desktop)
.toc-mobile
  display: none
  margin-bottom: 18px
  background: var(--bg-surface)
  border: 1px solid var(--border)
  border-radius: var(--radius-md)
  box-shadow: var(--shadow-sm)
  summary
    cursor: pointer
    padding: 14px 18px
    font-size: 15px
    font-weight: 700
    color: var(--text-primary)
    list-style: none
    display: flex
    align-items: center
    gap: 8px
    &::-webkit-details-marker
      display: none
    i
      color: var(--accent)
    &::after
      content: "\f078"
      font-family: "Font Awesome 6 Free"
      font-weight: 900
      margin-left: auto
      font-size: 12px
      color: var(--text-muted)
      transition: transform var(--transition-fast)
  &[open] summary::after
    transform: rotate(180deg)
  .toc-mobile-nav
    padding: 4px 14px 14px
    max-height: 320px
    overflow: auto

@media (max-width: 1100px)
  .post-shell
    grid-template-columns: 1fr
    gap: 0
  .post-toc-wrap
    display: none
  .toc-mobile
    display: block

@media (max-width: 640px)
  .topbar-nav
    display: none
  .topbar
    padding: 0 14px
  .taxonomy-page
    padding: 26px 20px

// ============================================================
// Article meta chips (read time / words / updated)
// ============================================================
.article-meta-chip
  display: inline-flex
  align-items: center
  gap: 6px
  padding: 5px 12px
  border-radius: var(--radius-full)
  background: var(--bg-elevated)
  border: 1px solid var(--border)
  color: var(--text-muted)
  font-size: 12.5px
  font-weight: 500
  i
    font-size: 12px
    color: var(--accent)

// ============================================================
// Home sidebar widgets
// ============================================================
.site-info-list
  list-style: none
  margin: 0
  padding: 0
  display: grid
  gap: 8px
  li
    display: flex
    align-items: center
    justify-content: space-between
    gap: 10px
    padding: 10px 14px
    border-radius: var(--radius-sm)
    background: var(--bg-elevated)
    border: 1px solid var(--border)
  .site-info-label
    display: inline-flex
    align-items: center
    gap: 7px
    color: var(--text-secondary)
    font-size: 13px
    i
      color: var(--accent)
      width: 15px
      text-align: center
  strong
    color: var(--text-primary)
    font-size: 15px
    font-weight: 700

.latest-list
  a
    display: flex
    align-items: center
    justify-content: space-between
    gap: 10px
  .latest-title
    flex: 1
    min-width: 0
    overflow: hidden
    text-overflow: ellipsis
    white-space: nowrap
  .latest-date
    flex-shrink: 0
    color: var(--text-muted)
    font-size: 12px

.category-list-name
  display: inline-flex
  align-items: center
  gap: 7px
  min-width: 0
  overflow: hidden
  text-overflow: ellipsis
  white-space: nowrap
  i
    color: var(--accent)

.category-list-count
  flex-shrink: 0
  padding: 2px 10px
  border-radius: var(--radius-full)
  background: var(--accent-bg)
  color: var(--accent)
  font-size: 12px
  font-weight: 600

.tag-cloud-more
  padding: 8px 14px
  border-radius: var(--radius-full)
  border: 1px dashed var(--border)
  color: var(--text-muted)
  font-size: 13px
  font-weight: 600
  &:hover
    color: var(--accent)
    border-color: var(--accent-border)
    background: var(--accent-bg)

// ============================================================
// Search dialog polish
// ============================================================
.search-meta
  margin: 0 0 10px
  min-height: 18px
  color: var(--text-muted)
  font-size: 13px

.search-result-item
  &.active
    border-color: var(--accent) !important
    background: var(--accent-bg) !important
    strong
      color: var(--accent) !important

mark
  background: rgba(250, 204, 21, .35)
  color: inherit
  padding: 0 2px
  border-radius: 3px

// ============================================================
// Article cover polish (match 30px card padding)
// ============================================================
.article-cover
  margin: -30px -30px 24px
  border-radius: 0
  img
    max-height: 340px

// ============================================================
// "Read more" link polish
// ============================================================
.article-more-link
  margin-top: 18px
  a
    display: inline-flex
    align-items: center
    gap: 8px
    padding: 9px 20px
    border-radius: var(--radius-full)
    background: var(--accent)
    color: #fff !important
    font-weight: 700
    font-size: 14px
    text-decoration: none
    border: none !important
    transition: all var(--transition-fast)
    &:hover
      background: var(--accent-hover)
      transform: translateX(3px)
      box-shadow: var(--shadow-md)
