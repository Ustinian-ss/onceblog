<!DOCTYPE html>
<html lang="<%= config.language %>">
<%- partial('_partial/head') %>
<body>
  <canvas id="starfield" aria-hidden="true"></canvas>
  <%- partial('_partial/loading') %>
  <div id="topbar" class="topbar" role="navigation" aria-label="吸顶导航">
    <a class="topbar-brand" href="<%- url_for() %>"><%= config.title %></a>
    <nav class="topbar-nav">
      <% for (var i in theme.menu){ %>
        <a class="topbar-link" href="<%- url_for(theme.menu[i]) %>"><%= i %></a>
      <% } %>
    </nav>
    <div class="topbar-actions">
      <button class="topbar-btn nav-search-btn" type="button" title="搜索 (Ctrl+K)" aria-label="搜索"><i class="fas fa-search"></i></button>
      <button class="topbar-btn topbar-theme-btn" type="button" title="切换主题" aria-label="切换主题"><i class="fas fa-moon"></i></button>
    </div>
  </div>
  <div id="container">
    <div id="wrap">
      <%- partial('_partial/header', null, {cache: !config.relative_link}) %>
      <div class="outer">
        <section id="main"><%- body %></section>
        <% if (theme.sidebar && theme.sidebar !== 'bottom'){ %>
          <%- partial('_partial/sidebar', null, {cache: !config.relative_link}) %>
        <% } %>
      </div>
      <%- partial('_partial/footer', null, {cache: !config.relative_link}) %>
    </div>
    <%- partial('_partial/mobile-nav', null, {cache: !config.relative_link}) %>
    <%- partial('_partial/after-footer') %>
  </div>
</body>
</html>
