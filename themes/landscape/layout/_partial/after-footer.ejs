<% if (theme.disqus_shortname){ %>
<script>
  var disqus_shortname = '<%= theme.disqus_shortname %>';
  <% if (page.permalink){ %>
  var disqus_url = '<%= page.permalink %>';
  <% } %>
  (function(){
    var dsq = document.createElement('script');
    dsq.async = true;
    dsq.src = 'https://' + disqus_shortname + '.disqus.com/<% if (page.comments) { %>embed.js<% } else { %>count.js<% } %>';
    (document.getElementsByTagName('head')[0] || document.getElementsByTagName('body')[0]).appendChild(dsq);
  })();
</script>
<% } %>
<div id="rightside">
  <div id="rightside-inner">
    <button id="darkmode-toggle" class="rightside-btn" type="button" title="切换深色/浅色模式" aria-label="切换深色/浅色模式">
      <i class="fas fa-moon"></i>
      <i class="fas fa-sun"></i>
    </button>
    <button id="go-up" class="rightside-btn" type="button" title="回到顶部" aria-label="回到顶部">
      <i class="fas fa-arrow-up"></i>
    </button>
  </div>
</div>
<div id="progress-bar"></div>
<script>
  (function(){
    var bar=document.getElementById('progress-bar');
    var ticking=false;
    window.addEventListener('scroll',function(){
      if(!ticking){requestAnimationFrame(function(){
        var st=document.documentElement.scrollTop||document.body.scrollTop;
        var sh=document.documentElement.scrollHeight-document.documentElement.clientHeight;
        if(sh>0){var pct=Math.min((st/sh)*100,100);bar.style.width=pct+'%';bar.classList.add('visible')}
        else{bar.classList.remove('visible')}
        ticking=false
      });ticking=true}
    },{passive:true})
  })()
</script>
<script>
  (function(){
    var dismissed=false;
    function dismiss(){
      if(dismissed)return;dismissed=true;
      var lb=document.getElementById('loading-box');
      if(!lb)return;
      lb.classList.add('loaded');
      setTimeout(function(){if(lb&&lb.parentNode)lb.parentNode.removeChild(lb)},700);
    }
    if(document.readyState==='complete'){setTimeout(dismiss,400)}
    else{window.addEventListener('load',function(){setTimeout(dismiss,400)})}
    setTimeout(dismiss,3500);
  })()
</script>

<script>
  // ===== 主题切换（共享给右侧按钮与吸顶栏按钮） =====
  (function(){
    var THEME = { light: 'light', dark: 'dark' };
    function current(){
      return document.documentElement.getAttribute('data-theme') === 'dark' ? THEME.dark : THEME.light;
    }
    function apply(theme){
      var d = document.documentElement;
      d.setAttribute('data-theme', theme);
      try{ localStorage.setItem('theme', theme); }catch(e){}
      var m = document.querySelector('meta[name="theme-color"]');
      if (m) m.setAttribute('content', theme === 'dark' ? '#0b1120' : '#f8f7f4');
    }
    window.toggleTheme = function(){
      apply(current() === 'dark' ? THEME.light : THEME.dark);
    };
    var rightToggle = document.getElementById('darkmode-toggle');
    if (rightToggle) rightToggle.addEventListener('click', window.toggleTheme);
  })();
</script>

<script>
  // ===== 吸顶导航栏显隐 =====
  (function(){
    var topbar = document.getElementById('topbar');
    if (!topbar) return;
    var timer = null;
    function update(){
      var t = document.documentElement.scrollTop || document.body.scrollTop;
      topbar.classList.toggle('visible', t > 240);
    }
    window.addEventListener('scroll', function(){
      if (timer) return;
      timer = requestAnimationFrame(function(){
        timer = null;
        update();
      });
    }, {passive: true});
    update();
    var themeBtn = topbar.querySelector('.topbar-theme-btn');
    if (themeBtn) themeBtn.addEventListener('click', function(){ window.toggleTheme && window.toggleTheme(); });
  })();
</script>

<div id="search-mask"></div>
<div id="search-dialog" role="dialog" aria-modal="true" aria-label="搜索文章">
  <div class="search-dialog-inner">
    <div class="search-header">
      <span class="search-title"><i class="fas fa-search" aria-hidden="true"></i> 搜索文章</span>
      <button class="search-close" type="button" aria-label="关闭搜索"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
    <div class="search-input-wrap">
      <input type="text" class="search-input" placeholder="输入关键词搜索，↑↓ 选择，Enter 打开，Esc 关闭..." aria-label="搜索关键词">
    </div>
    <div class="search-meta"></div>
    <div class="search-results"></div>
    <div class="search-empty">未找到相关内容</div>
  </div>
</div>
<script>
  (function(){
    var searchData = null;
    var searchUrl = '<%- url_for(config.search ? config.search.path : 'search.xml') %>';
    var mask = document.getElementById('search-mask');
    var dialog = document.getElementById('search-dialog');
    var input = dialog.querySelector('.search-input');
    var results = dialog.querySelector('.search-results');
    var empty = dialog.querySelector('.search-empty');
    var meta = dialog.querySelector('.search-meta');
    var closeBtn = dialog.querySelector('.search-close');
    var activeIndex = -1;
    var debounceTimer = null;

    function loadData(){
      if (searchData) return Promise.resolve(searchData);
      return fetch(searchUrl).then(function(r){ return r.text(); }).then(function(xml){
        var parser = new DOMParser();
        var doc = parser.parseFromString(xml, 'text/xml');
        var entries = doc.querySelectorAll('entry');
        searchData = [];
        entries.forEach(function(e){
          searchData.push({
            title: e.querySelector('title').textContent,
            url: e.querySelector('url').textContent,
            content: (e.querySelector('content').textContent || '').replace(/<[^>]+>/g, '').substring(0, 300)
          });
        });
        return searchData;
      }).catch(function(){ searchData = []; return searchData; });
    }

    function esc(s){
      return String(s).replace(/[&<>"']/g, function(c){
        return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
      });
    }
    function highlight(text, kw){
      var safe = esc(text);
      if (!kw) return safe;
      var idx = safe.toLowerCase().indexOf(kw);
      if (idx === -1) return safe;
      return safe.substring(0, idx) + '<mark>' + safe.substring(idx, idx + kw.length) + '</mark>' + safe.substring(idx + kw.length);
    }

    function render(hits, kw){
      meta.textContent = hits.length ? '找到 ' + hits.length + ' 条结果' : '';
      if (!hits.length){ results.innerHTML = ''; empty.style.display = 'block'; return; }
      empty.style.display = 'none';
      results.innerHTML = hits.map(function(item, i){
        return '<a class="search-result-item" href="' + esc(item.url) + '" data-index="' + i + '">' +
          '<strong>' + highlight(item.title, kw) + '</strong>' +
          '<p>' + highlight(item.content.substring(0, 110), kw) + '</p>' +
          '</a>';
      }).join('');
      activeIndex = -1;
    }

    function doSearch(q){
      var kw = q.trim().toLowerCase();
      if (!searchData || !kw){ results.innerHTML = ''; empty.style.display = 'none'; meta.textContent = ''; activeIndex = -1; return; }
      var hits = searchData.filter(function(item){
        return item.title.toLowerCase().indexOf(kw) > -1 || item.content.toLowerCase().indexOf(kw) > -1;
      });
      render(hits, kw);
    }

    function openSearch(){
      mask.classList.add('active');
      dialog.classList.add('active');
      document.body.style.overflow = 'hidden';
      loadData().then(function(){ setTimeout(function(){ input.focus(); }, 120); });
    }
    function closeSearch(){
      mask.classList.remove('active');
      dialog.classList.remove('active');
      document.body.style.overflow = '';
      clearTimeout(debounceTimer);
      input.value = '';
      results.innerHTML = '';
      empty.style.display = 'none';
      meta.textContent = '';
      activeIndex = -1;
    }

    function setActive(i){
      var items = results.querySelectorAll('.search-result-item');
      if (!items.length) return;
      if (i < 0) i = items.length - 1;
      if (i > items.length - 1) i = 0;
      activeIndex = i;
      items.forEach(function(el, idx){ el.classList.toggle('active', idx === i); });
      var el = items[i];
      if (el && el.scrollIntoView) el.scrollIntoView({block: 'nearest'});
    }

    document.querySelectorAll('.nav-search-btn').forEach(function(btn){
      btn.addEventListener('click', function(e){ e.preventDefault(); openSearch(); });
    });

    mask.addEventListener('click', closeSearch);
    closeBtn.addEventListener('click', closeSearch);
    input.addEventListener('input', function(){
      clearTimeout(debounceTimer);
      var v = this.value;
      debounceTimer = setTimeout(function(){ doSearch(v); }, 120);
    });
    input.addEventListener('keydown', function(e){
      if (e.key === 'ArrowDown'){ e.preventDefault(); setActive(activeIndex + 1); }
      else if (e.key === 'ArrowUp'){ e.preventDefault(); setActive(activeIndex - 1); }
      else if (e.key === 'Enter'){
        var items = results.querySelectorAll('.search-result-item');
        var target = activeIndex >= 0 ? items[activeIndex] : items[0];
        if (target && target.href){ window.location.href = target.href; }
      }
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') closeSearch();
      if ((e.ctrlKey || e.metaKey) && (e.key === 'k' || e.key === 'K')){
        e.preventDefault();
        if (dialog.classList.contains('active')) closeSearch(); else openSearch();
      }
    });
  })();
</script>

<script>
  // ===== 代码复制按钮 =====
  (function(){
    document.querySelectorAll('.article-entry pre').forEach(function(pre){
      var btn=document.createElement('button');
      btn.className='code-copy-btn';
      btn.type='button';
      btn.innerHTML='<i class="fas fa-copy" aria-hidden="true"></i> 复制';
      btn.addEventListener('click',function(){
        var code=pre.querySelector('code')||pre;
        navigator.clipboard.writeText(code.textContent).then(function(){
          btn.innerHTML='<i class="fas fa-check" aria-hidden="true"></i> 已复制';btn.style.background='rgba(34,197,94,.25)';
          setTimeout(function(){btn.innerHTML='<i class="fas fa-copy" aria-hidden="true"></i> 复制';btn.style.background=''},2000)
        }).catch(function(){
          btn.innerHTML='<i class="fas fa-times" aria-hidden="true"></i> 失败';
          setTimeout(function(){btn.innerHTML='<i class="fas fa-copy" aria-hidden="true"></i> 复制'},2000)
        })
      });
      pre.appendChild(btn)
    })
  })()
</script>

<script>
  // ===== 回到顶部 =====
  (function(){
    var btn = document.getElementById('go-up');
    if (!btn) return;
    function update(){
      var t = document.documentElement.scrollTop || document.body.scrollTop;
      btn.classList.toggle('shown', t > 400);
    }
    window.addEventListener('scroll', update, {passive: true});
    btn.addEventListener('click', function(){ window.scrollTo({top: 0, behavior: 'smooth'}); });
    update();
  })();
</script>

<script id="starfield-script">
(function(){
  var canvas = document.getElementById('starfield');
  if(!canvas)return;
  var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var ctx = canvas.getContext('2d');
  var DPR = Math.min(window.devicePixelRatio || 1, 2);
  var W=0,H=0,particles=[];
  var LINK_DIST=140,FR=0.90;
  var mouse={x:-1e9,y:-1e9};
  window.addEventListener('mousemove',function(e){
    // canvas 经 setTransform 后坐标系是 CSS 像素，鼠标坐标不要乘 DPR（HiDPI 屏会偏移一倍）
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  });
  function size(){
    W=window.innerWidth;H=window.innerHeight;
    canvas.width=Math.floor(W*DPR);canvas.height=Math.floor(H*DPR);
    canvas.style.width=W+'px';canvas.style.height=H+'px';
    ctx.setTransform(DPR,0,0,DPR,0,0);
  }
  function rnd(a,b){return Math.random()*(b-a)+a}
  function dark(){return document.documentElement.getAttribute('data-theme')==='dark'}
  function palette(){
    if(dark())return [[129,140,248],[167,139,250],[99,102,241],[196,181,253],[226,232,255],[244,244,255],[165,243,252],[255,255,255]];
    return [[79,70,229],[124,58,237],[139,92,246],[168,85,247],[217,70,239],[99,102,241],[109,40,217],[56,189,248]];
  }
  function build(){
    var count=Math.round(W*H/6500);
    count=Math.max(140,Math.min(260,count));
    if(reduce)count=64;
    particles=[];
    var pal=palette();
    for(var i=0;i<count;i++){
      var c=pal[Math.floor(Math.random()*pal.length)];
      particles.push({
        x:rnd(0,W),y:rnd(0,H),
        vx:rnd(-0.25,0.25),vy:rnd(-0.25,0.25),
        r:rnd(1.4,3.6),
        b:c,
        base:rnd(0.72,0.98),
        amp:rnd(0.18,0.32),
        ph:rnd(0,Math.PI*2),
        tw:rnd(0.0008,0.0022)
      });
    }
  }
  size();build();
  var rt;
  window.addEventListener('resize',function(){clearTimeout(rt);rt=setTimeout(function(){size();build()},180)});
  new MutationObserver(function(){
    var pal=palette();
    for(var i=0;i<particles.length;i++){
      var c=pal[Math.floor(Math.random()*pal.length)];
      particles[i].b=c;
    }
  }).observe(document.documentElement,{attributes:true,attributeFilter:['data-theme']});
  function rgba(b,a){return 'rgba('+b[0]+','+b[1]+','+b[2]+','+a+')'}
  var last=(typeof performance!=='undefined'?performance.now():Date.now());
  var rafId=null;
  function draw(now){
    now=now||(typeof performance!=='undefined'?performance.now():Date.now());
    var dt=now-last;last=now;
    ctx.clearRect(0,0,W,H);
    var n=particles.length;
    for(var i=0;i<n;i++){
      var p=particles[i];
      p.vx*=FR;p.vy*=FR;
      // 星芒随鼠标汇聚移动：鼠标附近的粒子被吸引
      var mdx = mouse.x - p.x;
      var mdy = mouse.y - p.y;
      var md2 = mdx*mdx + mdy*mdy;
      if(md2 < 2500){
        var md = Math.sqrt(md2);
        var pull = (1 - md/50) * 0.04;
        p.vx += mdx/md * pull;
        p.vy += mdy/md * pull;
      }
      p.x+=p.vx;p.y+=p.vy;
      if(p.x<-30)p.x=W+30;if(p.x>W+30)p.x=-30;
      if(p.y<-30)p.y=H+30;if(p.y>H+30)p.y=-30;
      p.ph+=p.tw*dt;
    }
    ctx.lineWidth=1;
    for(var a=0;a<n;a++){
      var pa=particles[a];
      for(var b=a+1;b<n;b++){
        var pb=particles[b];
        var dx=pa.x-pb.x,dy=pa.y-pb.y,d2=dx*dx+dy*dy;
        if(d2<LINK_DIST*LINK_DIST){
          var d=Math.sqrt(d2);
          var al=(1-d/LINK_DIST)*0.32;
          ctx.strokeStyle=rgba(pa.b,al);
          ctx.beginPath();ctx.moveTo(pa.x,pa.y);ctx.lineTo(pb.x,pb.y);ctx.stroke();
        }
      }
    }
    for(var k=0;k<n;k++){
      var p=particles[k];
      var tw=p.base+Math.sin(p.ph)*p.amp;
      if(tw<0)tw=0;if(tw>0.95)tw=0.95;
      var g=ctx.createRadialGradient(p.x,p.y,0,p.x,p.y,p.r*3.4);
      g.addColorStop(0,rgba(p.b,Math.min(tw*0.95,0.95)));
      g.addColorStop(0.5,rgba(p.b,tw*0.45));
      g.addColorStop(1,'rgba(0,0,0,0)');
      ctx.fillStyle=g;
      ctx.beginPath();ctx.arc(p.x,p.y,p.r*5,0,Math.PI*2);ctx.fill();
      ctx.fillStyle=rgba(p.b,tw);
      ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();
    }
    // 鼠标光晕效果
    if(mouse.x>0 && mouse.y>0){
      var halo = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, 40);
      halo.addColorStop(0,'rgba(255,255,255,0.4)');
      halo.addColorStop(1,'rgba(255,255,255,0)');
      ctx.fillStyle = halo;
      ctx.beginPath(); ctx.arc(mouse.x, mouse.y, 40, 0, Math.PI*2); ctx.fill();
    }
    ctx.lineWidth=1;
    rafId=requestAnimationFrame(draw);
  }
  // 减少动态效果偏好：静态星空，不启动动画循环
  if(reduce){
    // 只绘制一帧静态星点
    (function(){
      var pal=palette();
      for(var i=0;i<particles.length;i++){
        var p=particles[i],c=pal[Math.floor(Math.random()*pal.length)];
        ctx.fillStyle=rgba(c,0.5);
        ctx.beginPath();ctx.arc(p.x,p.y,p.r,0,Math.PI*2);ctx.fill();
      }
    })();
  } else {
    rafId=requestAnimationFrame(draw);
  }
  // 标签页隐藏时暂停动画，节省 CPU
  document.addEventListener('visibilitychange',function(){
    if(document.hidden){
      if(rafId!==null){cancelAnimationFrame(rafId);rafId=null;}
    } else {
      if(rafId===null && !reduce){last=(typeof performance!=='undefined'?performance.now():Date.now());rafId=requestAnimationFrame(draw);}
    }
  });
})();
</script>
